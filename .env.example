# Kredensial Supabase (FASE BACKEND P3). Copy ke `.env` bila dibutuhkan — TAPI
# nilai ini di-inject lewat compile-time define, bukan dibaca file saat runtime:
#
#   flutter run --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi...
#
# Tanpa kedua define ini, app tetap berjalan 100% lokal (drift SQLite)
# seperti sekarang.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================================
# OPERASIONAL (Makefile / tool/*.mjs) — bukan untuk runtime app.
# `SUPABASE_DB_PASSWORD` TIDAK boleh disimpan di file; berikan via env saat
# menjalankan target:  SUPABASE_DB_PASSWORD=... make validate-db-creds
# Contoh nilai di .env.local milik sesi dev (dilindungi gitignore).
# ============================================================================
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<dari user, jangan commit>